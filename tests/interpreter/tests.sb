fun test_equations() {
    if 3+2 != 5 {
        :print("1")
        return 1
    }

    if 30 + 5 / 5 != 31 {
        :print("2")
        return 1
    }

    if (10 + 5) / 3 != 5 {
        :print("3")
        return 1
    }

    if (5*3) != 15 {
        :print("4")
        return 1
    }

    if 10000 + 1 == 10000 {
        :print("5")
        return 1
    }

    if 10*4/5 != 8 {
        :print("6")
        return 1
    }

    if 2*2*2*2*2*2 != 64 {
        :print("7")
        return 1
    }

    if 10/5 != 2 {
        :print("8")
        return 1
    }

    if 100*2 != 200 {
        :print("9")
        return 1
    }

    if 10%2 != 0 {
        :print("10")
        return 1
    }

    return 0
}