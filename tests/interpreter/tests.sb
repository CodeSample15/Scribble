fun test_branching() {
    if false {
        return 1
    } else if false {
        return 1
    } else if true {
        if true {
            if false {
                return 1
            } else {
                return 0
            }
        } else if false {
            return 1
        } else {
            return 1
        }
    } else {
        return 1
    }
}

