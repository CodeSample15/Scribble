fun test_loops() {
    num i=0
    repeat 100 {
        i += 1
    }

    if i != 100 {
        return 1
    }

    while i > 0 {
        repeat 5 {
            i -= 1
        }
    }

    if i > 0 {
        return 1
    }

    return 0
}

fun test_variables() {
    num a, b, c, d = 5

    if !(a == 5 && 
        b == 5 &&
        c == 5 &&
        d == 5) {
            return 1
        }

    float f = 34.3
    if f != 34.3 {
        return 1
    }

    #check defaults
    float defaultFloat
    num defaultInt
    string defaultString

    if defaultFloat != 0 {
        return 1
    }

    if defaultInt != 0 {
        return 1
    }

    if defaultString != "" {
        return 1
    }

    return 0
}

fun test_string_concat() {
    string test = "hi"

    test = test + 4
    if test != "hi4" {
        return 1
    }

    test += "ever"
    if test != "hi4ever" {
        return 1
    }

    test += test
    if test != "hi4everhi4ever" {
        return 1
    }

    return 0
}

fun test_string_assign() {
    string test

    test = "hi"
    if test != "hi" {
        return 1
    }

    test = ""+4
    if test != "4" {
        return 1
    }

    test = "hi " + "there"
    if test != "hi there" {
        return 1
    }

    test = 0 + "1" + "2" + "3" + 4 + "5"
    if test != "012345" {
        return 1
    }

    return 0
}

fun test_string_compare() {
    string one, two

    if one != two {
        return 1
    }

    one = "one"
    two = "two"
    if one == two {
        :print("he2re")
        return 1
    }

    one = "123"
    two = "123"
    if one != two {
        return 1
    }

    one = "1234"
    if one != two + 4 {
        return 1
    }

    return 0
}

fun test_bitwise() {
    num test = 1

    if !(test & 1) {
        return 1
    }

    if test & 0 {
        return 1
    }

    if !(test | 0) {
        return 1
    }

    if test ^ 1 {
        return 1
    }

    test = 0

    if test | 0 {
        return 1
    }

    if !(test | 1) {
        return 1
    }

    if test & 0 {
        return 1
    }

    if !(test^1) {
        return 1
    }

    num mask = 1
    mask = mask << 2
    if mask != 4 {
        return 1
    }

    mask = mask >> 2
    if mask != 1 {
        return 1
    }

    return 0
}